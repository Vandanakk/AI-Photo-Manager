# Database
DATABASE_URL=postgresql+asyncpg://photouser:photopass@db:5432/photodb

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage
LOCAL_STORAGE_PATH=/data/photos
UPLOAD_MAX_SIZE_MB=50

# Google Photos (optional — leave blank to skip Google Photos sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/photos/google/callback

# App
DEBUG=false
